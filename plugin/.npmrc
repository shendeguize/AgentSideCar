# The machine-default registry is the npmmirror mirror, whose @deepseek-ai
# scope is stale (e.g. dsh-agent pinned at 0.1.0-rc.6 while the official
# registry carries 0.1.1-rc.2). Pin the scopes this package consumes to the
# official registry; everything else keeps the user's default.
@deepseek-ai:registry=https://registry.npmjs.org/
@shendeguize:registry=https://registry.npmjs.org/
