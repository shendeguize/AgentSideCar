# Local workspace — private, never tracked
.local/

# Agent workspaces (plans, scratch, session state) — keep .cursor/rules/ tracked
.cursor/*
!.cursor/rules/
.claude/
.codex/
.agent/

# Tool-local caches
.codegraph/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
_site/
site/assets/shots/.*.tmp.png

# dsh plugin (TypeScript npm sub-package under plugin/)
# plugin/lib/ is a tracked build output on purpose: dsh loads the prebuilt
# lib/ from the npm package and git installs need it — never ignore it.
plugin/node_modules/
plugin/coverage/
plugin/**/*.tsbuildinfo

# macOS
.DS_Store

# Editors
.idea/
*.swp
